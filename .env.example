# MCP client auth — every request
MCP_TOKEN=

# Fleet bot webhook endpoint URL
WEBHOOK_URL=

# Shared secret for webhook auth (Authorization + X-Automation-Key headers)
WEBHOOK_KEY=

# Path to agent data directory (default: /home/box/agent-data)
# STORE_ROOT=/home/box/agent-data

# ID of the Fleet bot in the store (default: fleet)
# FLEET_BOT_ID=fleet

# Server listen port (default: 8080)
# PORT=8080
